# Moch Browser configuration template.
# Copy to .env or export in your shell/session. Moch reads the variable named
# in settings (ai.api_key_env), default MOCH_API_KEY.
#
# The key is NEVER written to settings.json, logs, or model payloads.
# Alternatively, store the key in ~/.local/share/moch/secret (chmod 600).

MOCH_API_KEY=sk-your-key-here

# Optional: point at any OpenAI-compatible endpoint (OpenRouter, Groq,
# Together, Ollama, LM Studio, vLLM). Configured in the Settings dialog or
# ~/.config/moch/settings.json:
#   ai.base_url = https://openrouter.ai/api/v1
#   ai.model    = openai/gpt-4o-mini
# No additional environment variables are required for those.
