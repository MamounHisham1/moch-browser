/* Moch light theme — Chrome/Brave-style chrome.
 * Mirrors dark.qss structure; accent #3d6ea5, chrome #e9ebef,
 * active tab white like Chrome light. */

* {
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow, QDialog {
    background: #f7f7f8;
    color: #1d2026;
}

/* ---- Chrome header: tab strip + toolbar share one surface ---- */

QWidget#tabStrip, QWidget#navToolbar {
    background: #e9ebef;
    border: none;
}

QWidget#navToolbar {
    border-bottom: 1px solid #d9dce2;
    padding: 4px 8px;
    spacing: 2px;
}

/* ---- Buttons: flat 32x32 tiles with rounded hover ---- */

QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #4a4e57;
}

QToolButton:hover {
    background: #dcdfe6;
}

QToolButton:pressed {
    background: #d3d7df;
}

QToolButton#iconButton:checked {
    background: rgba(61, 110, 165, 0.14);
}

QToolButton#iconButton:checked:hover {
    background: rgba(61, 110, 165, 0.22);
}

QToolButton:disabled {
    color: #a7abb3;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ---- Address bar: floating pill, accent ring on focus ---- */

QLineEdit#addressBar {
    background: #ffffff;
    border: 1px solid transparent;
    border-radius: 17px;
    padding: 6px 14px 6px 38px;
    min-height: 18px;
    color: #1d2026;
    selection-background-color: #b9d1ea;
}

QLineEdit#addressBar:hover {
    background: #fdfdfe;
}

QLineEdit#addressBar:focus {
    background: #ffffff;
    border-color: #3d6ea5;
}

/* ---- Tab strip: rounded-top chips, active tab elevated ---- */

QTabBar {
    background: transparent;
    padding-left: 6px;
}

QTabBar::tab {
    background: transparent;
    color: #5a5e67;
    border: none;
    border-radius: 9px 9px 0 0;
    padding: 8px 8px 8px 12px;
    min-width: 120px;
    max-width: 220px;
    margin: 5px 2px 0 2px;
}

QTabBar::tab:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #1d2026;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #000000;
}

QTabBar::close-button {
    image: url(:/icons/tab-close.svg);
    subcontrol-position: right center;
    width: 16px;
    height: 16px;
    margin: 0 2px;
}

QTabBar::close-button:hover {
    background: #cfd4dc;
    border-radius: 4px;
}

QToolButton#newTabButton {
    border-radius: 8px;
    padding: 7px;
    margin: 4px 4px 0 0;
}

/* ---- Find bar ---- */

QWidget#findBar {
    background: #e9ebef;
    border-bottom: 1px solid #d9dce2;
}

QLineEdit#findInput {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
    padding: 5px 10px;
    color: #1d2026;
    selection-background-color: #b9d1ea;
}

QLineEdit#findInput:focus {
    border-color: #3d6ea5;
}

QLabel#findStatus {
    color: #6a6f7a;
}

/* ---- Inputs ---- */

QLineEdit, QTextEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1d2026;
    selection-background-color: #b9d1ea;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #c3c7cf;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #3d6ea5;
}

QLineEdit#aiInput {
    border-radius: 10px;
    padding: 8px 12px;
}

QTextEdit#aiTranscript {
    background: transparent;
    border: none;
    padding: 2px;
    font-size: 13px;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1d2026;
}

QComboBox:hover {
    border-color: #c3c7cf;
}

QComboBox:focus {
    border-color: #3d6ea5;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/combo-arrow.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
    color: #1d2026;
    selection-background-color: #dfe7f3;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    border-radius: 6px;
    padding: 4px 8px;
}

QSpinBox {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
    padding: 5px 8px;
    color: #1d2026;
}

QSpinBox:focus {
    border-color: #3d6ea5;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

/* ---- Buttons (dialogs, sidebar actions) ---- */

QPushButton {
    background: #ececef;
    color: #1d2026;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background: #e2e3e7;
    border-color: #c9cad0;
}

QPushButton:pressed {
    background: #d8d9de;
}

QPushButton:focus {
    border-color: #3d6ea5;
}

QPushButton:disabled {
    color: #a7abb3;
    background: #efeff2;
    border-color: #e4e4e8;
}

QPushButton:default {
    border-color: #3d6ea5;
}

QPushButton#accentButton {
    background: #3d6ea5;
    border-color: #3d6ea5;
    color: #ffffff;
}

QPushButton#accentButton:hover {
    background: #356194;
    border-color: #356194;
}

QPushButton#accentButton:pressed {
    background: #2f567f;
}

QPushButton#dangerButton {
    background: #f3dede;
    border-color: #e0c4c4;
    color: #a03a3a;
}

QPushButton#dangerButton:hover {
    background: #edd2d2;
}

/* ---- Menus ---- */

QMenu {
    background: #ffffff;
    color: #1d2026;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #eef1f6;
}

QMenu::item:disabled {
    color: #a7abb3;
}

QMenu::separator {
    height: 1px;
    background: #e4e4e8;
    margin: 5px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

/* ---- Lists (history, downloads, routines, sessions) ---- */

QListWidget {
    background: #ffffff;
    border: 1px solid #e0e1e7;
    border-radius: 8px;
    color: #1d2026;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    border-radius: 6px;
    padding: 7px 9px;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background: #f0f0f3;
}

QListWidget::item:selected {
    background: #dfe7f3;
    color: #1d2026;
}

QWidget#downloadsPanel {
    background: #ffffff;
    border: 1px solid #d5d8de;
    border-radius: 8px;
}

QWidget#downloadsPanel QListWidget {
    background: transparent;
    border: none;
}

/* ---- Headers / views ---- */

QHeaderView::section {
    background: #e9ebef;
    color: #6a6f7a;
    border: none;
    border-bottom: 1px solid #d9dce2;
    padding: 6px 8px;
    font-weight: 600;
}

QTableView, QTreeView {
    background: #ffffff;
    alternate-background-color: #f7f8fa;
    border: 1px solid #e0e1e7;
    border-radius: 8px;
    color: #1d2026;
    selection-background-color: #dfe7f3;
    selection-color: #1d2026;
}

/* ---- Tooltips ---- */

QToolTip {
    background: #ffffff;
    color: #1d2026;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 5px 9px;
}

/* ---- Scrollbars: slim floating pill, accent while dragging ---- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px 1px;
}

QScrollBar::handle:vertical {
    background: #c9ccd4;
    border-radius: 4px;
    min-height: 36px;
    margin: 0 2px;
}

QScrollBar::handle:vertical:hover {
    background: #3d6ea5;
}

QScrollBar::handle:vertical:pressed {
    background: #4f82bb;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 1px 2px;
}

QScrollBar::handle:horizontal {
    background: #c9ccd4;
    border-radius: 4px;
    min-width: 36px;
    margin: 2px 0;
}

QScrollBar::handle:horizontal:hover {
    background: #3d6ea5;
}

QScrollBar::handle:horizontal:pressed {
    background: #4f82bb;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* ---- Checkbox ---- */

QCheckBox {
    spacing: 8px;
    color: #1d2026;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #c3c4ca;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #3d6ea5;
}

QCheckBox::indicator:checked {
    background: #3d6ea5;
    border-color: #3d6ea5;
    image: url(:/icons/check.svg);
}

QCheckBox:disabled {
    color: #a7abb3;
}

/* ---- AI sidebar (visual polish only; logic untouched) ---- */

QWidget#aiSidebar {
    background: #f2f2f4;
    border-left: 1px solid #d9dce2;
}

QLabel#aiHeaderIcon {
    background: transparent;
}

QLabel#aiTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1d2026;
}

QLabel#aiStatus {
    color: #6a6c76;
    font-size: 12px;
}
