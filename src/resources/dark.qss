* {
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QMainWindow, QToolBar, QTabBar, QStackedWidget, QWidget#tabStrip {
    background: #141517;
    color: #e8e8ea;
}

QWidget#navToolbar {
    border: none;
    border-bottom: 1px solid #26282c;
}

QWidget#navToolbar QToolButton, QWidget#findBar QToolButton, QToolButton#newTabButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    color: #c9cbd1;
    font-size: 15px;
}

QWidget#navToolbar QToolButton:hover, QWidget#findBar QToolButton:hover,
QToolButton#newTabButton:hover {
    background: #24262b;
    color: #ffffff;
}

QWidget#navToolbar QToolButton:disabled {
    color: #55575e;
}

QWidget#navToolbar QToolButton:checked {
    color: #4a7db5;
}

QToolButton::menu-indicator {
    image: none;
}

QWidget#tabStrip QToolButton#newTabButton {
    background: #191a1d;
    font-size: 16px;
    padding: 6px 10px;
}

QWidget#findBar {
    background: #191a1d;
    border-bottom: 1px solid #26282c;
}

QLineEdit#findInput {
    background: #1e2024;
    border: 1px solid #2a2d33;
    border-radius: 12px;
    padding: 4px 12px;
    color: #e8e8ea;
}

QLabel#findStatus {
    color: #8a8c93;
}

QLineEdit#addressBar {
    background: #1e2024;
    border: 1px solid #2a2d33;
    border-radius: 14px;
    padding: 5px 14px;
    color: #e8e8ea;
    selection-background-color: #3d6ea5;
}

QLineEdit#addressBar:focus {
    border: 1px solid #4a7db5;
}

QTabBar {
    background: #191a1d;
}

QTabBar::tab {
    background: transparent;
    color: #a0a2a9;
    border: none;
    border-right: 1px solid #222428;
    padding: 6px 12px;
    min-width: 120px;
    max-width: 220px;
}

QTabBar::tab:hover {
    background: #222429;
}

QTabBar::tab:selected {
    background: #141517;
    color: #ffffff;
    border-top: 2px solid #4a7db5;
}

QTabBar::close-button {
    image: none;
    subcontrol-position: right;
    background: transparent;
    border-radius: 4px;
    margin: 2px;
}

QTabBar::close-button:hover {
    background: #3a3d44;
}

QTabBar::tear, QTabBar::scroller {
    background: #191a1d;
}
