/* Moch dark theme — Chrome/Brave-style chrome.
 * Palette anchors (shared with the AI sidebar HTML): chrome #1f2127,
 * elevated surface #2c3746, accent #5b8def. */

* {
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow, QDialog {
    background: #141517;
    color: #e9ebf0;
}

/* ---- Chrome header: tab strip + toolbar share one surface ---- */

QWidget#tabStrip, QWidget#navToolbar {
    background: #1f2127;
    border: none;
}

QWidget#navToolbar {
    border-bottom: 1px solid #272b33;
    padding: 4px 8px;
    spacing: 2px;
}

/* ---- Buttons: flat 32x32 tiles with rounded hover ---- */

QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #c9cbd1;
}

QToolButton:hover {
    background: #2a2e37;
}

QToolButton:pressed {
    background: #232732;
}

QToolButton#iconButton:checked {
    background: rgba(91, 141, 239, 0.18);
}

QToolButton#iconButton:checked:hover {
    background: rgba(91, 141, 239, 0.28);
}

QToolButton:disabled {
    color: #5d626c;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ---- Address bar: floating pill, accent ring on focus ---- */

QLineEdit#addressBar {
    background: #17191f;
    border: 1px solid transparent;
    border-radius: 17px;
    padding: 6px 14px 6px 38px;
    min-height: 18px;
    color: #e9ebf0;
    selection-background-color: #3d5a8a;
}

QLineEdit#addressBar:hover {
    background: #191c23;
}

QLineEdit#addressBar:focus {
    background: #1d212b;
    border-color: #5b8def;
}

/* ---- Tab strip: rounded-top chips, active tab elevated ---- */

QTabBar {
    background: transparent;
    padding-left: 6px;
}

QTabBar::tab {
    background: transparent;
    color: #9aa0ab;
    border: none;
    border-radius: 9px 9px 0 0;
    padding: 8px 8px 8px 12px;
    min-width: 120px;
    max-width: 220px;
    margin: 5px 2px 0 2px;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #c9cbd1;
}

QTabBar::tab:selected {
    background: #2c3746;
    color: #ffffff;
}

QTabBar::close-button {
    image: url(:/icons/tab-close.svg);
    subcontrol-position: right center;
    width: 16px;
    height: 16px;
    margin: 0 2px;
}

QTabBar::close-button:hover {
    background: #3a4150;
    border-radius: 4px;
}

QToolButton#newTabButton {
    border-radius: 8px;
    padding: 7px;
    margin: 4px 4px 0 0;
}

/* ---- Find bar ---- */

QWidget#findBar {
    background: #1f2127;
    border-bottom: 1px solid #272b33;
}

QLineEdit#findInput {
    background: #17191f;
    border: 1px solid #2b2f38;
    border-radius: 8px;
    padding: 5px 10px;
    color: #e9ebf0;
    selection-background-color: #3d5a8a;
}

QLineEdit#findInput:focus {
    border-color: #5b8def;
}

QLabel#findStatus {
    color: #9aa0ab;
}

/* ---- Inputs ---- */

QLineEdit, QTextEdit, QPlainTextEdit {
    background: #17191f;
    border: 1px solid #2b2f38;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e9ebf0;
    selection-background-color: #3d5a8a;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #343945;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #5b8def;
}

QLineEdit#aiInput {
    border-radius: 10px;
    padding: 8px 12px;
}

QTextEdit#aiTranscript {
    background: transparent;
    border: none;
    padding: 2px;
    font-size: 13px;
}

QComboBox {
    background: #17191f;
    border: 1px solid #2b2f38;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e9ebf0;
}

QComboBox:hover {
    border-color: #343945;
}

QComboBox:focus {
    border-color: #5b8def;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/combo-arrow.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: #232833;
    border: 1px solid #343945;
    border-radius: 8px;
    color: #e9ebf0;
    selection-background-color: #2c3746;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    border-radius: 6px;
    padding: 4px 8px;
}

QSpinBox {
    background: #17191f;
    border: 1px solid #2b2f38;
    border-radius: 8px;
    padding: 5px 8px;
    color: #e9ebf0;
}

QSpinBox:focus {
    border-color: #5b8def;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

/* ---- Buttons (dialogs, sidebar actions) ---- */

QPushButton {
    background: #262a33;
    color: #e9ebf0;
    border: 1px solid #32363f;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background: #2d323d;
    border-color: #3b4050;
}

QPushButton:pressed {
    background: #21252d;
}

QPushButton:focus {
    border-color: #5b8def;
}

QPushButton:disabled {
    color: #5d626c;
    background: #22252c;
    border-color: #2b2f38;
}

QPushButton:default {
    border-color: #3d5a8a;
}

QPushButton#accentButton {
    background: #5b8def;
    border-color: #5b8def;
    color: #ffffff;
}

QPushButton#accentButton:hover {
    background: #6d99f1;
    border-color: #6d99f1;
}

QPushButton#accentButton:pressed {
    background: #4a7de0;
}

QPushButton#dangerButton {
    background: #4a2b2b;
    border-color: #5d3434;
    color: #ffb9b9;
}

QPushButton#dangerButton:hover {
    background: #5d3434;
}

/* ---- Menus ---- */

QMenu {
    background: #232833;
    color: #e9ebf0;
    border: 1px solid #32363f;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #2c3746;
}

QMenu::item:disabled {
    color: #5d626c;
}

QMenu::separator {
    height: 1px;
    background: #32363f;
    margin: 5px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

/* ---- Lists (history, downloads, routines, sessions) ---- */

QListWidget {
    background: #17191f;
    border: 1px solid #262a32;
    border-radius: 8px;
    color: #e9ebf0;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    border-radius: 6px;
    padding: 7px 9px;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background: #23262e;
}

QListWidget::item:selected {
    background: #2c3746;
    color: #ffffff;
}

QWidget#downloadsPanel {
    background: #1e2129;
    border: 1px solid #2e3340;
    border-radius: 8px;
}

QWidget#downloadsPanel QListWidget {
    background: transparent;
    border: none;
}

/* ---- Headers / views ---- */

QHeaderView::section {
    background: #1f2127;
    color: #9aa0ab;
    border: none;
    border-bottom: 1px solid #272b33;
    padding: 6px 8px;
    font-weight: 600;
}

QTableView, QTreeView {
    background: #17191f;
    alternate-background-color: #1a1d24;
    border: 1px solid #262a32;
    border-radius: 8px;
    color: #e9ebf0;
    selection-background-color: #2c3746;
    selection-color: #ffffff;
}

/* ---- Tooltips ---- */

QToolTip {
    background: #262a33;
    color: #e9ebf0;
    border: 1px solid #32363f;
    border-radius: 6px;
    padding: 5px 9px;
}

/* ---- Scrollbars: slim floating pill, accent while dragging ---- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px 1px;
}

QScrollBar::handle:vertical {
    background: #333845;
    border-radius: 4px;
    min-height: 36px;
    margin: 0 2px;
}

QScrollBar::handle:vertical:hover {
    background: #5b8def;
}

QScrollBar::handle:vertical:pressed {
    background: #7aa5f5;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 1px 2px;
}

QScrollBar::handle:horizontal {
    background: #333845;
    border-radius: 4px;
    min-width: 36px;
    margin: 2px 0;
}

QScrollBar::handle:horizontal:hover {
    background: #5b8def;
}

QScrollBar::handle:horizontal:pressed {
    background: #7aa5f5;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* ---- Checkbox ---- */

QCheckBox {
    spacing: 8px;
    color: #e9ebf0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #3a3f4b;
    background: #17191f;
}

QCheckBox::indicator:hover {
    border-color: #5b8def;
}

QCheckBox::indicator:checked {
    background: #5b8def;
    border-color: #5b8def;
    image: url(:/icons/check.svg);
}

QCheckBox:disabled {
    color: #5d626c;
}

/* ---- AI sidebar (visual polish only; logic untouched) ---- */

QWidget#aiSidebar {
    background: #17181c;
    border-left: 1px solid #272b33;
}

QLabel#aiHeaderIcon {
    background: transparent;
}

QLabel#aiTitle {
    font-size: 14px;
    font-weight: 700;
    color: #e9ebf0;
}

QLabel#aiStatus {
    color: #8a8d94;
    font-size: 12px;
}
